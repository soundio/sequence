{
    "imports": {
        "fn/":   "https://cdn.jsdelivr.net/gh/stephband/fn@1.7.0/modules/",
        "midi/": "https://cdn.jsdelivr.net/gh/stephband/midi@1.2.0/modules/"
    },

    "tasks": {
        "validate-lexicons": "goat lex lint ./lexicons",
        "publish-lexicons":  "goat lex publish --update ./lexicons",
        "transpose-file":    "deno run --allow-read=. --allow-write=. deno/transpose-file.js"
    },

    "lint": {
        "rules": {
            "exclude": ["no-unused-vars", "no-fallthrough", "no-case-declarations", "no-cond-assign"]
        }
    },

    "compilerOptions": {
        "strict": true
    },

    "lock": false
}
